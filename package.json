{
  "name": "@yolo-labs/yolobridge",
  "version": "0.32.1",
  "description": "Attach your own local coding agent (Claude Code, Codex) to a YOLO Studio workspace as a first-class tile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yolo-labs-hq/yolobridge.git"
  },
  "homepage": "https://github.com/yolo-labs-hq/yolobridge#readme",
  "bugs": {
    "url": "https://github.com/yolo-labs-hq/yolobridge/issues"
  },
  "type": "module",
  "bin": {
    "yolo-bridge": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec dist/*.test.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
